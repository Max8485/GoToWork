<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <changeSet id="2026-07-27-recreate-partition-p10" author="Maxim">
        <sql>
            DROP TABLE IF EXISTS user_settings_p10 CASCADE;
            -- Создаём новую с MAXVALUE
            CREATE TABLE user_settings_p10 PARTITION OF user_settings
            FOR VALUES FROM (2000000) TO (MAXVALUE);
        </sql>
    </changeSet>
    </databaseChangeLog>